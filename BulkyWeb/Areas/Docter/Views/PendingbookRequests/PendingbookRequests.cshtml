@using BulkyBookModels.Model
@model List<BookingPagecs>
<h2>Pending Book Requests</h2>

<link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true" />

<table class="table">
    <thead>
        <tr>
            <th>Student Name</th>
            <th>Student ID</th>
            <th>Student Book</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var request in Model.Where(x => x.Requst == null))
        {
            <tr>
                <td>@request.User_Name</td>
                <td>@request.IDNumber</td>
                <td>@request.time</td>
                <td>
                    <form method="post">
                        <input type="hidden" name="ID" value="@request.ID" />
                        <button type="submit"
                                name="action"
                                value="approve"
                                asp-route-id="@request.ID"
                                class="btn btn-success">
                            Approve
                        </button>
                        <button type="submit"
                                name="action"
                                value="reject"
                                asp-route-id="@request.ID"
                                class="btn btn-danger">
                            Reject
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

  <h2>Approved Students</h2>
  <table class="table">
      <thead>
          <tr>
              <th>Student Name</th>
              <th>Student ID</th>
              <th>Student Book</th>
          </tr>
      </thead>
      <tbody>
          @foreach (var approvedRequest in Model.Where(r => r.Requst == true))
          {
              <tr>
                  <td>@approvedRequest.User_Name</td>
                  <td>@approvedRequest.IDNumber</td>
                  <td>@approvedRequest.time</td>
              </tr>
          }
      </tbody>
  </table>