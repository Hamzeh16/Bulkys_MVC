@using BulkyBookModels.Model
@model Feedback

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/feedbackForm.css">

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@*     <script src="sweetalert2.min.js"></script>
    <script src="sweetalert2.all.min.js"></script> *@

    <title>FeedBack</title>
</head>

<body>
    <div id="mainContainer">
        <div id="feedback-form">
            <h2 class="header">Feedback Form</h2>
            <div>
                <form method="post">
                    <div id="textTag">
                        <textarea asp-for="@Model.Comment" class="message" name="Comment" placeholder="Enter Your Comment"
                                  spellcheck="false"></textarea>
                    </div>
                    <br>
                    <input class="inputz" asp-for="@Model.email" name="email" id="email" type="hidden" />
                    <button type="submit">Submit</button>
                </form>
            </div>
        </div>
    </div>
</body>

</html>
@* <script src="~/js/feedbackForm.js"></script> *@